# ---------------------------------------------------------------------------
# KAMAI.AI frontend configuration
# ---------------------------------------------------------------------------
# Leave VITE_API_BASE_URL empty to use same-origin "/api" (Vite dev proxy will
# forward to BACKEND_ORIGIN, default http://localhost:8000).
VITE_API_BASE_URL=

# "mock"  -> fully client-side deterministic demo engine (no backend needed)
# "live"  -> calls the real backend at VITE_API_BASE_URL
# "auto"  -> tries live, falls back to mock if the backend is unreachable
VITE_DATA_SOURCE=auto

# Demo driver id used by the whole app
VITE_DEMO_DRIVER_ID=DRV-0001
